{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"testsEnvironment": false,
	"plugins": [ "." ],
	"port": 8888,
	"config": {
		"JETPACK_AUTOLOAD_DEV": true,
		"ABILITIES_CATALOG_MCP_ENABLED": true,
		"ABILITIES_CATALOG_META_PROBE": true,
		"ABILITIES_CATALOG_FAKE_ABILITIES": 0,
		"WP_ENVIRONMENT_TYPE": "local",
		"WP_DEVELOPMENT_MODE": "plugin",
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": "/var/www/html/wp-content/debug.log",
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true
	}
}
