.DS_Store
Thumbs.db
*.log
/vendor/
/node_modules/

# Distributable plugin zip built by `npm run plugin-zip` (and by the release CI).
/abilities-catalog.zip

# Local wp-env config (machine-specific plugin paths)
/.wp-env.local.json
/.wp-env.override.json
/.wp-env.multisite.json

# Local MCP client config — holds an Application Password; never commit.
# Pattern covers stray duplicates too (e.g. ".mcp copy.json").
/.mcp.json
.mcp*.json

# Test output (keep the directory, ignore generated reports/caches)
/tests/_output/*
!/tests/_output/.gitkeep
!/tests/e2e/
!/tests/e2e/**

# MCP Adapter plugin release fetched by `npm run mcp-adapter:fetch` for wp-env,
# PHPUnit and phpstan. A soft runtime dependency; the release zip never ships it.
/tests/plugins/

# composer.lock IS committed: the plugin has runtime deps (the REST adapter and
# the Jetpack Autoloader), and the CI release build runs `composer install --no-dev`.

# Phpactor (editor LSP) local index/config — machine-specific.
/.phpactor.json
